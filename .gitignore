__pycache__/
*.py[cod]
.venv/
venv/
env/

# Large local data files are regenerated from scripts and should not be committed.
data/raw/
data/processed/**/*.npy
data/processed/**/*.csv.gz
data/processed/**/sample_index.csv.gz

# Downloaded literature PDFs are kept locally only.
风预测规划/文献/*.pdf

# Keep compact run summaries, metrics and the small current checkpoint, but ignore ad-hoc logs.
outputs/**/*.log

